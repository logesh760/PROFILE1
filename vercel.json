{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/logeshwaran_m.pdf"
    },
    {
      "source": "/resume.pdf",
      "destination": "/logeshwaran_m.pdf"
    },
    {
      "source": "/Logeshwaran_M.pdf",
      "destination": "/logeshwaran_m.pdf"
    },
    {
      "source": "/Style.css",
      "destination": "/style.css"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"logeshwaran_m.pdf\""
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|jpg|jpeg|png|svg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
